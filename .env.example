# ==================== 模型配置 ====================
MODEL_NAME=kurisu_model
MODEL_TYPE=pytorch
DEVICE=cuda
PRETRAINED_MODEL_PATH=./models/pretrained

# ==================== API 配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_WORKERS=4

# ==================== LLM 配置 ====================
# OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# 或其他 LLM 服务
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1

# ==================== Live2D 配置 ====================
LIVE2D_MODEL_PATH=./live2d/models/kurisu
LIVE2D_ANIMATION_SPEED=1.0
LIVE2D_TEXTURE_PATH=./live2d/models/kurisu/textures
LIVE2D_ANIMATION_PATH=./live2d/models/kurisu/animations

# ==================== TTS 配置 ====================
TTS_ENGINE=kurisu_voice
TTS_SAMPLE_RATE=22050
TTS_VOICE_STYLE=normal
TTS_VOICE_PATH=./tts/voices/kurisu

# Azure TTS (可选)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastasia

# Google TTS (可选)
GOOGLE_CLOUD_CREDENTIALS=./credentials.json

# ==================== 语音识别 ====================
SPEECH_RECOGNITION_ENGINE=whisper
WHISPER_MODEL=base
WHISPER_API_KEY=your-whisper-api-key

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite:///./amadeus.db
# DATABASE_URL=postgresql://user:password@localhost/amadeus_db

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ==================== 记忆系统配置 ====================
MEMORY_ENGINE=redis
MEMORY_MAX_SIZE=10000
MEMORY_RETENTION_DAYS=30
MEM0_API_KEY=your-mem0-api-key

# ==================== 对话配置 ====================
MAX_CONTEXT_LENGTH=10
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=512
DIALOG_TIMEOUT=30

# ==================== 红莉栖人格配置 ====================
PERSONALITY_MODE=kurisu
PERSONALITY_INTENSITY=0.8  # 0-1，表示人格特征的强度
SARCASM_LEVEL=0.7          # 红莉栖的傲娇程度
SCIENTIFIC_INTEREST=0.9    # 科学兴趣度

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_PATH=./logs
LOG_FILE_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=10

# ==================== 安全配置 ====================
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ==================== 功能开关 ====================
ENABLE_VOICE_SYNTHESIS=true
ENABLE_LIVE2D_RENDERING=true
ENABLE_EMOTION_DETECTION=true
ENABLE_MEMORY_SYSTEM=true
ENABLE_WEBSOCKET=true

# ==================== 移动端配置 ====================
MOBILE_MODEL_QUANTIZATION=true
MOBILE_INFERENCE_OPTIMIZATION=true
MOBILE_MAX_MEMORY_MB=500

# ==================== 调试和开发 ====================
DEBUG=true
DEVELOPMENT=true
TESTING=false
